{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"],
            "dependsOn": "CMake: Configure"
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake --build build --config Release",
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"],
            "dependsOn": "CMake: Configure"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run VoxelEngine",
            "type": "shell",
            "command": "${workspaceFolder}/build/Debug/VoxelEngine.exe",
            "group": "test",
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        }
    ]
}
